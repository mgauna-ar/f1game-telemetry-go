# ==============================================================================
# F1 Telemetry Analyzer - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the folder you start the app from, or next to the
# executable. The app reads it at startup. Variables already set in your
# environment take priority, and command-line flags (-udp, -http, -db,
# -no-browser) take priority over both.
# All settings are optional; empty values fall back to the defaults.
# ==============================================================================

# Network & Server Settings
F1T_UDP_ADDR=0.0.0.0:20777      # UDP telemetry listener address and port
F1T_HTTP_ADDR=:8080             # Web UI, REST API, and WebSocket server address
F1T_DB_PATH=                    # SQLite database file (default: f1telemetry.db in the current folder)
F1T_NO_BROWSER=                 # Set to true to stop the browser opening on startup

# AI Race Engineer Configuration (Optional - can also be configured in the UI)
GEMINI_API_KEY=                 # Google Gemini API key (https://aistudio.google.com/)
OPENAI_API_KEY=                 # OpenAI API key (https://platform.openai.com/)
# The AI provider and model are chosen in the AI settings drawer in the app.
