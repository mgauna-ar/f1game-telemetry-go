# ==============================================================================
# F1 Telemetry Analyzer - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and update the values as needed.
# All environment variables are optional with sane production defaults.
# ==============================================================================

# Network & Server Settings
F1T_UDP_ADDR=0.0.0.0:20777      # UDP telemetry listener address and port
F1T_HTTP_ADDR=:8080             # Web UI, REST API, and WebSocket server address

# AI Race Engineer Configuration (Optional - can also be configured in the UI)
GEMINI_API_KEY=                 # Google Gemini API key (https://aistudio.google.com/)
OPENAI_API_KEY=                 # OpenAI API key (https://platform.openai.com/)
LLM_PROVIDER=gemini             # Default LLM provider: 'gemini' or 'openai'
LLM_MODEL=gemini-flash-lite-latest # Default model identifier
